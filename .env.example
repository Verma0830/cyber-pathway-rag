# CyberPathway RAG Environment Configuration
# All defaults are 100% free and require $0.00 expenditure.

# Server Settings
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# LLM Provider Configuration
# Options: 'local' (Default $0 built-in synthesizer), 'gemini' (Free-tier), 'ollama' (Local free)
LLM_PROVIDER=local

# Optional: Google Gemini Free-Tier API Key (15 RPM / 1M TPM at $0.00)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Optional: Local Ollama Endpoint
OLLAMA_ENDPOINT=http://localhost:11434

# Embedding Configuration
# Uses built-in 384-dim semantic vectorizer at $0 cost
EMBEDDING_PROVIDER=local

# Database Location
SQLITE_DB_PATH=./data/cyber_rag.db
