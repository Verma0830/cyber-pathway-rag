  "description": "Zero-Cost Production-Grade Cybersecurity Learning and Career-Guidance RAG Application",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node --experimental-sqlite src/server.js",
    "dev": "node --experimental-sqlite --watch src/server.js",
